# Server configuration
PORT=8080

# Database Configuration
# Replace with your local or remote PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexai

# Clerk Authentication (Backend & Frontend)
# Retrieve these credentials from your Clerk dashboard (https://clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Frontend Clerk Configuration (Vite requires VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# AI Provider Configuration
# Choose local Ollama for development, or bedrock/openai for external inference.
AI_PROVIDER=ollama

# Local Ollama settings (preferred for local development and free usage)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# AWS Bedrock configuration (optional, used only when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# AWS cost safeguards
MAX_AI_REQUESTS_PER_USER=20
MAX_DOCUMENT_SIZE_MB=10
MAX_CONTEXT_CHUNKS=5
MAX_OUTPUT_TOKENS=1500

# AWS document pipeline configuration
AWS_S3_BUCKET_NAME=
AWS_S3_DOCUMENT_PREFIX=documents

# OpenAI API fallback (used only when AI_PROVIDER=openai)
# Retrieve from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Clerk Proxy (needed if deploying with a proxy setup in production)
# VITE_CLERK_PROXY_URL=http://localhost:8080/api/__clerk
