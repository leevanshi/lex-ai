# Server configuration
PORT=8080
NODE_ENV=production

# Database Configuration
# Replace with your production PostgreSQL connection string
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=lexai
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/lexai

# Clerk Authentication (Backend & Frontend)
# Retrieve these credentials from your Clerk dashboard (https://clerk.com)
# IMPORTANT: Use production keys, not test keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Frontend Clerk Configuration (Vite requires VITE_ prefix)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Optional: Clerk Proxy URL (if using proxy setup in production)
# VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# Optional: Application URL (for CORS and redirects)
# APP_URL=https://your-domain.com
